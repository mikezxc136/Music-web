# Mẫu biến môi trường — copy thành .env rồi điền giá trị thật.
# File .env đã nằm trong .gitignore, KHÔNG được commit lên GitHub.
# Các giá trị ở đây chỉ dùng cho backend/server, không bao giờ nhúng vào HTML/JS của trang tĩnh.

# ----- Database -----
# Chuỗi kết nối đầy đủ, ví dụ: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true

# ----- Nếu instance là Supabase (bỏ trống nếu không dùng) -----
SUPABASE_URL=
# anon key: được phép công khai ở frontend
SUPABASE_ANON_KEY=
# service role key: toàn quyền, chỉ dùng ở server
SUPABASE_SERVICE_ROLE_KEY=

# ----- Ứng dụng -----
APP_ENV=development
APP_URL=http://localhost:8080
# Chuỗi ngẫu nhiên dài để ký phiên đăng nhập (tạo bằng: openssl rand -hex 32)
SESSION_SECRET=

# ----- Thanh toán QR (điền khi chọn SePay hoặc payOS) -----
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
BANK_ACCOUNT_NUMBER=
BANK_CODE=
BANK_ACCOUNT_NAME=

# ----- Video bài giảng (điền khi chọn nơi lưu video) -----
VIDEO_PROVIDER=
VIDEO_API_KEY=
